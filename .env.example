# Proposed variable names. Implementation must explicitly load .env or use shell env.
# Never put real values in this committed template.
DD_SITE=datadoghq.eu
DD_API_KEY=
DD_APP_KEY=

# Copy the API base URL from your Dash0 organization's Settings > Endpoints.
# EU example only; use your organization's actual endpoint.
DASH0_API_URL=https://api.eu-west-1.aws.dash0.com
DASH0_AUTH_TOKEN=
DASH0_DATASET=default

# On-demand live comparison: explicit OTLP/HTTP base endpoint from Dash0 Settings.
# No /v1/metrics suffix. --dash0-dataset selects ingestion, querying and publication.
DASH0_OTLP_ENDPOINT=
